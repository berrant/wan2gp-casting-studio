# JSON is private by default; only factory placeholders and metadata are tracked.
*.json
!/plugin_info.json
!/app/casting_db.json
!/app/refmod_identities.json

# User images and generated media; only generic shipped icons are tracked.
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.mp4
*.webm
*.mov
*.wav
